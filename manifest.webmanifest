<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#13192b">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="TamaPoke Family">
  <title>TamaPoke Family v0.3</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="apple-touch-icon" href="assets/icons/icon-192.png">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main id="app" class="app-shell">
    <section id="slotScreen" class="screen active" aria-labelledby="slotTitle">
      <header class="topbar">
        <div>
          <p class="eyebrow">PRIVATE FAMILIENVERSION</p>
          <h1 id="slotTitle">TamaPoke Family</h1>
        </div>
        <button id="openSettingsBtn" class="round-btn" type="button" aria-label="Einstellungen">⚙</button>
      </header>

      <article class="welcome-panel">
        <div class="egg-logo" aria-hidden="true"><span></span></div>
        <div>
          <h2>Euer eigenes Pokémon-Abenteuer</h2>
          <p>Drei getrennte Spielstände. Die Daten bleiben auf diesem Gerät gespeichert.</p>
        </div>
      </article>

      <div id="slotList" class="slot-list" aria-live="polite"></div>

      <footer class="legal-note">
        Inoffizielles, nicht kommerzielles Fanprojekt. TamaPoke-Port mit Sprites von PMD SpriteCollab.
      </footer>
    </section>

    <section id="starterScreen" class="screen" aria-labelledby="starterTitle">
      <header class="topbar compact">
        <button class="round-btn" type="button" data-nav="slots" aria-label="Zurück">←</button>
        <div class="center-title">
          <p class="eyebrow">NEUER SPIELSTAND</p>
          <h2 id="starterTitle">Wähle deinen Starter</h2>
        </div>
        <span class="topbar-spacer" aria-hidden="true"></span>
      </header>

      <label class="field-label" for="trainerName">Trainername</label>
      <input id="trainerName" class="text-input" maxlength="18" autocomplete="off" placeholder="z. B. Emil">
      <p class="helper">Dein Starter beginnt zunächst als Ei und schlüpft nach drei Berührungen.</p>

      <div id="starterGrid" class="starter-grid"></div>
    </section>

    <section id="gameScreen" class="screen" aria-labelledby="petTitle">
      <header class="game-topbar">
        <button id="backToSlotsBtn" class="round-btn glass" type="button" aria-label="Spielstandauswahl">⌂</button>
        <div class="game-title">
          <span id="trainerLabel">Trainer</span>
          <strong id="petTitle">Ei</strong>
        </div>
        <button id="openDexBtn" class="round-btn glass" type="button" aria-label="Pokédex öffnen">▦</button>
      </header>

      <section id="habitat" class="habitat theme-meadow day" aria-label="Lebensraum deines Pokémon">
        <div class="world-badge" aria-label="Aktuelle Pokémon-Welt"><span id="worldIcon" class="world-symbol symbol-star"></span><span><strong id="worldName">Pokémon-Wiese</strong><small id="worldPhase">TAG</small></span></div>
        <div class="world-pixel-overlay" aria-hidden="true"></div>
        <div class="sky-decor" aria-hidden="true">
          <span class="sun-moon"></span>
          <span class="cloud cloud-one"></span>
          <span class="cloud cloud-two"></span>
          <span class="star star-one">✦</span>
          <span class="star star-two">✧</span>
        </div>
        <div id="speechBubble" class="speech-bubble">Tippe auf das Ei.</div>
        <button id="petTouchArea" class="pet-touch" type="button" aria-label="Pokémon berühren">
          <canvas id="petCanvas" width="320" height="240" aria-label="Animiertes Pokémon"></canvas>
          <div id="eggView" class="egg-view" aria-hidden="true">
            <span class="egg-spot spot-a"></span><span class="egg-spot spot-b"></span><span class="egg-spot spot-c"></span>
            <i id="eggCrackOne"></i><i id="eggCrackTwo"></i>
          </div>
        </button>
        <div id="poopRow" class="poop-row" aria-label="Verschmutzungen"></div>
        <div class="ground-shadow" aria-hidden="true"></div>
        <span id="shinyBadge" class="shiny-badge" hidden>✦ SHINY</span>
        <div id="bathOverlay" class="bath-overlay" hidden aria-hidden="true">
          <div class="bath-tub">🛁</div><div class="bath-bubbles"></div><strong>Splish splash!</strong>
        </div>
        <div id="evolutionOverlay" class="evolution-overlay" hidden aria-hidden="true">
          <div class="evolution-halo"></div><div class="evolution-rays"></div><strong>Entwicklung!</strong>
        </div>
      </section>

      <button id="evolveBanner" class="event-banner evolve-banner" type="button" hidden>
        <span>✨</span><span><strong>Entwicklung möglich</strong><small>Tippen, um zu entscheiden</small></span><span>›</span>
      </button>
      <button id="farewellBanner" class="event-banner farewell-banner" type="button" hidden>
        <span>💛</span><span><strong id="farewellBannerTitle">Dein Pokémon möchte dir etwas sagen</strong><small>Der gemeinsame Lebenszyklus ist abgeschlossen</small></span><span>›</span>
      </button>
      <button id="runawayBanner" class="event-banner runaway-banner" type="button" hidden>
        <span>💧</span><span><strong id="runawayBannerTitle">Dein Pokémon fühlt sich verlassen</strong><small>Tippe, um die Szene zu öffnen</small></span><span>›</span>
      </button>

      <section class="status-grid" aria-label="Pflegewerte">
        <article class="status-card">
          <div><span>🍓 Sättigung</span><strong id="fullnessValue">80</strong></div>
          <div class="meter"><span id="fullnessBar"></span></div>
        </article>
        <article class="status-card">
          <div><span>♥ Freude</span><strong id="joyValue">80</strong></div>
          <div class="meter"><span id="joyBar"></span></div>
        </article>
        <article class="status-card">
          <div><span>⚡ Energie</span><strong id="energyValue">80</strong></div>
          <div class="meter"><span id="energyBar"></span></div>
        </article>
        <article class="status-card">
          <div><span>✦ Hygiene</span><strong id="hygieneValue">100</strong></div>
          <div class="meter"><span id="hygieneBar"></span></div>
        </article>
      </section>

      <section class="summary-strip" aria-label="Fortschritt">
        <div><span>LEVEL</span><strong id="levelValue">1</strong></div>
        <div><span>BINDUNG</span><strong id="bondValue">0</strong></div>
        <div><span>SERIE</span><strong id="streakValue">0</strong></div>
        <div><span>ALTER</span><strong id="ageValue">0m</strong></div>
      </section>

      <nav class="action-dock" aria-label="Pflegeaktionen">
        <button type="button" data-action="food"><span>🍓</span><small>Füttern</small></button>
        <button type="button" data-action="play"><span>★</span><small>Spielen</small></button>
        <button type="button" data-action="train"><span>🥊</span><small>Training</small></button>
        <button type="button" data-action="clean"><span>🫧</span><small>Waschen</small></button>
        <button type="button" data-action="sleep"><span>☾</span><small id="sleepActionLabel">Schlafen</small></button>
        <button type="button" data-action="info"><span>ⓘ</span><small>Info</small></button>
      </nav>
    </section>

    <section id="dexScreen" class="screen" aria-labelledby="dexTitle">
      <header class="topbar compact">
        <button class="round-btn" type="button" data-nav="game" aria-label="Zurück">←</button>
        <div class="center-title">
          <p class="eyebrow">SAMMLUNG</p>
          <h2 id="dexTitle">Pokédex <span id="dexCount">0/151</span></h2>
        </div>
        <span class="topbar-spacer" aria-hidden="true"></span>
      </header>
      <label class="search-box" for="dexSearch">
        <span>⌕</span>
        <input id="dexSearch" type="search" placeholder="Name oder Nummer suchen">
      </label>
      <div id="dexGrid" class="dex-grid"></div>
    </section>
  </main>

  <dialog id="foodDialog" class="sheet-dialog">
    <div class="sheet-card">
      <div class="sheet-handle"></div>
      <div class="sheet-head"><div><p class="eyebrow">FÜTTERN</p><h2>Was darf es sein?</h2></div><button class="round-btn close-dialog" type="button">✕</button></div>
      <div class="food-grid">
        <button type="button" data-berry="0"><span class="food-icon berry-red"></span><strong>Rote Beere</strong><small>Kräftig und süß</small></button>
        <button type="button" data-berry="1"><span class="food-icon berry-blue"></span><strong>Blaue Beere</strong><small>Frisch und saftig</small></button>
        <button type="button" data-berry="2"><span class="food-icon berry-green"></span><strong>Grüne Beere</strong><small>Mild und knackig</small></button>
        <button type="button" id="candyBtn"><span class="food-icon candy-star"></span><strong>Tama-Bonbon</strong><small>Viel Freude, mehr Gewicht</small></button>
      </div>
    </div>
  </dialog>

  <dialog id="infoDialog" class="sheet-dialog">
    <div class="sheet-card tall">
      <div class="sheet-handle"></div>
      <div class="sheet-head"><div><p class="eyebrow">POKÉMON-PASS</p><h2 id="infoName">Pokémon</h2></div><button class="round-btn close-dialog" type="button">✕</button></div>
      <div class="nickname-row">
        <input id="nicknameInput" class="text-input" maxlength="11" placeholder="Spitzname">
        <button id="saveNicknameBtn" type="button" class="primary-btn">Speichern</button>
      </div>
      <div id="infoMetrics" class="info-metrics"></div>
      <h3>Gene & Training</h3>
      <div id="combatStats" class="combat-grid"></div>
      <h3>Fortschritt & Lebenszyklus</h3>
      <div id="lifeProgress" class="life-progress"></div>
      <h3>Medaillen</h3>
      <div id="medalGrid" class="medal-grid"></div>
      <button id="newEggBtn" class="secondary-btn" type="button">Pokémon freiwillig freilassen</button>
    </div>
  </dialog>

  <dialog id="dexDetailDialog" class="sheet-dialog">
    <div class="sheet-card">
      <div class="sheet-handle"></div>
      <div class="sheet-head"><div><p class="eyebrow" id="dexDetailNumber">#001</p><h2 id="dexDetailName">Bisasam</h2></div><button class="round-btn close-dialog" type="button">✕</button></div>
      <div class="dex-detail-stage"><canvas id="dexDetailCanvas" width="260" height="190"></canvas><div id="dexLocked" class="dex-locked">?</div></div>
      <div id="dexDetailMeta" class="info-metrics"></div>
    </div>
  </dialog>

  <dialog id="evolutionChoiceDialog" class="choice-dialog">
    <div class="choice-card"><span class="choice-icon">✨</span><p class="eyebrow">ENTWICKLUNG</p><h2 id="evolutionChoiceTitle">Entwickeln?</h2><p id="evolutionChoiceText">Dein Pokémon ist bereit.</p><button id="acceptEvolutionBtn" class="primary-btn full" type="button">Jetzt entwickeln</button><button id="declineEvolutionBtn" class="secondary-btn" type="button">Form vorerst behalten</button></div>
  </dialog>
  <dialog id="farewellChoiceDialog" class="choice-dialog">
    <div class="choice-card farewell-choice"><span class="choice-icon">💛</span><p class="eyebrow">GEMEINSAMER WEG</p><h2 id="farewellChoiceTitle">Abschied nehmen?</h2><p id="farewellChoiceText">Nach einem erfüllten Lebenszyklus kann ein neues Ei erscheinen.</p><button id="acceptFarewellBtn" class="primary-btn full" type="button">Dankbar verabschieden</button><button id="declineFarewellBtn" class="secondary-btn" type="button">Noch zusammenbleiben</button></div>
  </dialog>
  <dialog id="ceremonyDialog" class="ceremony-dialog">
    <div id="ceremonyScene" class="ceremony-scene"><div class="ceremony-particles" aria-hidden="true"></div><p id="ceremonyKicker" class="eyebrow">AUF WIEDERSEHEN</p><h2 id="ceremonyTitle">Danke für die gemeinsame Zeit</h2><canvas id="ceremonyCanvas" width="420" height="330" aria-label="Abschiedsszene"></canvas><p id="ceremonyText">Ein neues Abenteuer wartet.</p><div class="ceremony-progress"><span id="ceremonyProgressBar"></span></div></div>
  </dialog>

  <dialog id="settingsDialog" class="sheet-dialog">
    <div class="sheet-card tall">
      <div class="sheet-handle"></div>
      <div class="sheet-head"><div><p class="eyebrow">APP</p><h2>Einstellungen</h2></div><button class="round-btn close-dialog" type="button">✕</button></div>
      <label class="setting-row" for="paceSelect"><span><strong>Spieltempo</strong><small>Familientempo läuft viermal langsamer</small></span><select id="paceSelect"><option value="family">Familientempo</option><option value="original">Originaltempo</option><option value="test">Testtempo (5 Sekunden)</option></select></label>
      <label class="setting-row switch-row" for="soundToggle"><span><strong>Ton</strong><small>Retro-Signale im Browser</small></span><input id="soundToggle" type="checkbox" checked></label>
      <label class="setting-row switch-row" for="motionToggle"><span><strong>Animationen</strong><small>Sprite- und Hintergrundbewegungen</small></span><input id="motionToggle" type="checkbox" checked></label>
      <label class="setting-row" for="worldTimeSelect"><span><strong>Weltzeit</strong><small>Automatisch folgt der Uhrzeit des Geräts</small></span><select id="worldTimeSelect"><option value="auto">Automatisch</option><option value="day">Immer Tag</option><option value="night">Immer Nacht</option></select></label>
      <div class="credits-box">
        <strong>Credits & Nutzung</strong>
        <p>Privates, nicht kommerzielles Fanprojekt auf Grundlage von TamaPoke (Quique Tortosa, MIT). Sprites: PMD SpriteCollab, CC BY-NC 4.0. Pokémon © Nintendo / Game Freak / The Pokémon Company.</p>
      </div>
      <button id="resetAllBtn" class="danger-btn" type="button">Alle drei Spielstände löschen</button>
    </div>
  </dialog>

  <dialog id="miniGameDialog" class="game-dialog">
    <div class="mini-card"><div class="mini-head"><div><p id="miniGameKicker" class="eyebrow">MINISPIEL</p><h2 id="miniGameTitle">Pokéball-Fangen</h2></div><button id="cancelMiniBtn" class="round-btn" type="button">✕</button></div><div class="mini-score"><span>Zeit <strong id="miniTime">20</strong></span><span>Punkte <strong id="miniScore">0</strong></span><span>Fehler <strong id="miniMisses">0/3</strong></span></div><div id="miniArena" class="mini-arena ball-game-arena"><div class="mini-sky-decor" aria-hidden="true"></div><div id="miniBall" class="mini-ball" hidden></div><div id="miniPet" class="mini-pet"><canvas id="miniPetCanvas" width="170" height="120"></canvas></div><p id="miniStartHint">Bewege dein Pokémon mit dem Finger und fange den Pokéball.</p></div><button id="startMiniBtn" class="primary-btn full" type="button">Start</button></div>
  </dialog>

  <dialog id="trainDialog" class="game-dialog">
    <div class="mini-card">
      <div class="mini-head"><div><p class="eyebrow">KRAFTTRAINING</p><h2 id="trainGameTitle">Trainingssack</h2></div><button id="cancelTrainBtn" class="round-btn" type="button">✕</button></div>
      <div class="mini-score"><span>Zeit <strong id="trainTime">10</strong></span><span>Treffer <strong id="trainHits">0</strong></span><span>Kombo <strong id="trainCombo">0</strong></span></div>
      <div class="bag-arena"><div id="trainPet" class="train-pet"><canvas id="trainPetCanvas" width="190" height="150"></canvas></div><button id="punchBag" type="button" aria-label="Trainingssack schlagen"><span></span></button><p id="trainStartHint">Tippe rhythmisch auf den Sack.</p></div>
      <button id="startTrainBtn" class="primary-btn full" type="button">Start</button>
    </div>
  </dialog>

  <div id="toast" class="toast" aria-live="polite"></div>
  <script type="module" src="js/app.js"></script>
</body>
</html>
